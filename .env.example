# Copy to .env and fill in. Never commit .env.

# Dexcom account used by the G7 app (the account that *shares*, not a follower).
# Can be an email, a phone number in +<country><number> form (e.g. +15551234567),
# or the Dexcom account ID (UUID).
DEXCOM_USERNAME=+15551234567
DEXCOM_PASSWORD=change-me
# us = United States, ous = outside the US, jp = Japan
DEXCOM_REGION=us

# Nightscout site, no trailing slash.
NIGHTSCOUT_URL=https://my-nightscout.example.com
# Either your API_SECRET (plain or already SHA-1 hashed)...
NIGHTSCOUT_API_SECRET=change-me-too
# ...or an access token from Admin Tools (e.g. n8n-dexcom-xxxxxxxxxxxx). Its subject needs the "readable"
# role plus a role with the api:entries:create permission (see README: "Nightscout access token").
#NIGHTSCOUT_TOKEN=

# Seconds between checks when running as a service (minimum 60). G7 posts a reading every 5 min.
POLL_INTERVAL=120
# How far back (minutes, max 1440) to backfill when Nightscout has no recent data.
BACKFILL_MINUTES=1440
# Shown as the "device" on each Nightscout entry.
DEVICE_NAME=dexcom-g7-ns-uploader
# info or debug
LOG_LEVEL=info
